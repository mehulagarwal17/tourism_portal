# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RAZORPAY_KEY_ID: Razorpay API Key ID (from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"

# RAZORPAY_KEY_SECRET: Razorpay API Key Secret
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET"

# OMNIDIM_API_KEY: OmniDimension AI Voice Agent API Key (from https://omnidim.io)
OMNIDIM_API_KEY="MY_OMNIDIM_API_KEY"

# OMNIDIM_AGENT_ID: OmniDimension Voice Agent ID
OMNIDIM_AGENT_ID="2601"

# OMNIDIM_AGENT_SECRET: OmniDimension Agent Chat/Voice Widget Secret Key
OMNIDIM_AGENT_SECRET="39637dd016b2b44c3e09067387fc6445"
